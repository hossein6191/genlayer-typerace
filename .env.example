# ---------- Core ----------
# Port the API binds to. SERVER_PORT takes precedence over PORT, which lets a
# dev harness set PORT for the web server without moving the API onto it.
SERVER_PORT=8787
# PORT=8787
NODE_ENV=development
# Public URL of the deployed app (used for the invite links)
PUBLIC_URL=http://localhost:5173

# ---------- Security ----------
# Long random string. Generate with:  openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-string
# Password for the /admin panel
ADMIN_PASSWORD=change-me

# ---------- Database ----------
# SQLite file path (relative paths resolve against the server folder)
DATABASE_FILE=./data/genlayer-typerace.db
