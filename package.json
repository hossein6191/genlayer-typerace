{
  "name": "genlayer-typerace",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": ["client", "server"],
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "concurrently -n server,client -c magenta,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm --workspace server run dev",
    "dev:client": "npm --workspace client run dev",
    "build": "npm --workspace client run build && npm --workspace server run build",
    "start": "npm --workspace server run start",
    "typecheck": "npm --workspace client run typecheck && npm --workspace server run typecheck"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
